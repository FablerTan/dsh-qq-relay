{
  "name": "dsh-qq-relay",
  "version": "0.1.0",
  "description": "把 DeepSeek Harness（DSH）接入 QQ 机器人的桥插件：host 半身规划连接 QQ 机器人协议端、在 QQ 与 DSH 会话之间双向转发消息，client 半身预留状态 / 配置面板。当前 v0.1.0 空骨架，功能待实现。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-syntax.mjs && tsc --noEmit && node scripts/check-docs.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
