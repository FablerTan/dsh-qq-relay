{
  "name": "dsh-qq-relay",
  "version": "0.10.0",
  "description": "把 DeepSeek Harness（DSH）接入 QQ 机器人的桥插件（host + client 双半身）。当前 v0.10.0：P1「@ 直通」已真机验收（OneBot 11 正向 WS，群聊优先）；P1.5 基础配置页（设置 →「QQ 机器人」）已落地；P2.1/P2.2 消息闸门骨架与收尾已落地；P2.3 jev 分类器已接（OpenRouter typesafe/jev-1.14）；P3 qq_send 主动推送与 QQ 侧审批已落地；P4 群项目目录 + 聊天记录 .qq-relay/ + prompt 拼接已落地；P4.1 入向图片 / 表情落盘到 .qq-relay/media/ 已落地。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-syntax.mjs && tsc --noEmit && node scripts/check-docs.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
