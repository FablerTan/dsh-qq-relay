{
  "name": "dsh-qq-relay",
  "version": "0.25.2",
  "description": "把 DeepSeek Harness（DSH）接入 QQ 机器人的桥插件：host 半身连 OneBot 11 正向 WebSocket 做消息闸门 / 工具 / 审批，client 半身在插件面板「dsh-qq-relay」组合包页面提供配置页。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/skills/**",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FablerTan/dsh-qq-relay.git"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-syntax.mjs && tsc --noEmit && node scripts/check-docs.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
